{
    "$defs": {
        "CatalogItem": {
            "properties": {
                "hash": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "relative_path": {
                    "type": "string"
                },
                "size": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "source_path": {
                    "type": "string"
                },
                "tags": {
                    "anyOf": [
                        {
                            "items": {
                                "$ref": "#/$defs/Tag"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "type": {
                    "$ref": "#/$defs/CatalogItemType"
                }
            },
            "required": [
                "source_path",
                "relative_path",
                "type"
            ],
            "type": "object"
        },
        "CatalogItemType": {
            "enum": [
                "file",
                "folder"
            ],
            "type": "string"
        },
        "StorageMap": {
            "properties": {
                "storage_map": {
                    "additionalProperties": {
                        "type": "string"
                    },
                    "type": "object"
                }
            },
            "required": [
                "storage_map"
            ],
            "type": "object"
        },
        "Tag": {
            "properties": {
                "name": {
                    "type": "string"
                },
                "ns": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                }
            },
            "required": [
                "name",
                "ns",
                "value"
            ],
            "type": "object"
        },
        "WRAPPModelVersion": {
            "properties": {
                "version_string": {
                    "pattern": "[0-9]+(\\.[0-9]+)?",
                    "type": "string"
                }
            },
            "required": [
                "version_string"
            ],
            "type": "object"
        }
    },
    "additionalProperties": true,
    "properties": {
        "format_version": {
            "$ref": "#/$defs/WRAPPModelVersion",
            "default": {
                "version_string": "2.0"
            }
        },
        "items": {
            "items": {
                "$ref": "#/$defs/CatalogItem"
            },
            "type": "array"
        },
        "root": {
            "type": "string"
        },
        "storage_map": {
            "anyOf": [
                {
                    "$ref": "#/$defs/StorageMap"
                },
                {
                    "type": "null"
                }
            ],
            "default": null
        }
    },
    "required": [
        "root",
        "items"
    ],
    "type": "object"
}